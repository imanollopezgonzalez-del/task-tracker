rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /mailing/{companyId}/{allPaths=**} {
      // Gmail y los destinatarios necesitan poder cargar la imagen/adjunto sin auth
      allow read: if true;

      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.companyId == companyId
        && (
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
          || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.crmAccess == true
        )
        && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
